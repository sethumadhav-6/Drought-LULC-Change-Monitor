ENVIRONMENT=development

# --- Google Earth Engine (primary Sentinel-2/Landsat source) ---
# Create a service account in a Google Cloud project with Earth Engine
# API enabled, register it at https://code.earthengine.google.com/register,
# download its JSON key, then set EITHER the file path (local dev) OR
# the raw JSON as one line (Render/production).
GEE_SERVICE_ACCOUNT=canopy-geoai@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-key.json
# GEE_SERVICE_ACCOUNT_KEY_JSON={"type": "service_account", ...}
GEE_PROJECT=your-gcp-project-id

# --- Admin workflow ---
ADMIN_USERNAME=canopyceo
ADMIN_PASSWORD=plothy@4578

# --- Flask session cookie signing (admin login on the Flask app) ---
# Any long random string; changing it logs out all active admin sessions.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Database: MySQL (primary). Leave MYSQL_HOST unset to fall back to a
# local SQLite file instead (fine for quick testing, not for production). ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=canopy
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=canopy_geoai
# Or set this instead of the MYSQL_* vars above to point at any SQLAlchemy
# DB URL directly (e.g. a different host, or Postgres):
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/canopy_geoai

# --- CORS (only relevant if you're also running the legacy Next.js/FastAPI
# stack -- the primary Flask app is same-origin and doesn't need this) ---
ALLOWED_ORIGINS=["http://localhost:4521"]

# --- Storage ---
DATA_STORE_DIR=./data_store
